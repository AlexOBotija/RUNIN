# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your key never goes to GitHub.

# Your Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# The Gemini model name to use (chosen in Step 0)
GEMINI_MODEL=

# How many random athletes go into data/processed/sample.parquet (default 1000)
SAMPLE_SIZE=1000
