# Virtual environment
.venv/
venv/

# Secrets (never commit these)
.env
.streamlit/secrets.toml

# Data files (downloaded or generated, too big for Git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.parquet
*.csv
# Exceptions: the two small processed files the app needs on the cloud (under 1 MB).
# They come after the rules above, so they win.
!data/processed/sample.parquet
!data/processed/reference.parquet

# Python caches and build files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Editors, AI tools and OS
.vscode/
.idea/
.claude/
Thumbs.db
.DS_Store

# Personal step prompts (kept local, not part of the project)
prompts/
